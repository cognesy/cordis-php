# Dependencies and Composer credentials. composer.lock is intentionally tracked
# so contributors run the same QA toolchain as CI.
/vendor/
/composer.phar
/auth.json
/.composer/auth.json

# Test results, coverage, benchmark output, and static-analysis caches.
/.phpunit.cache/
/.phpunit.result.cache
/.phpunit/
/.pest/
/coverage/
/build/
/dist/
/artifacts/
/reports/
/test-results/
/clover.xml
/coverage.xml
/junit.xml
/.phpstan/
/phpstan-cache/
/.psalm/
/psalm-report.json
/.php-cs-fixer.cache
/.pint.cache
/.rector.cache
/rector.cache
/.infection.cache
/infection.log
/.phpbench/

# Runtime and local development state.
/var/cache/
/var/log/
/var/runtime/
/tmp/
/temp/
/.cache/
/.direnv/
/.envrc.local
/docker-compose.override.yml

# Environment files and credentials. Keep only explicitly safe templates.
/.env
/.env.*
!/.env.example
!/.env.dist
!/.env.sample
!/.env.testing.example
/secrets/
/credentials/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
!tests/Fixtures/**/*.pem
!tests/Fixtures/**/*.key

# JavaScript tooling may be used for documentation or release tooling.
/node_modules/
/.npm/
/.yarn/
/.pnpm-store/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*
/.vite/
/docs/_build/
/docs/.vitepress/dist/

# Editor, IDE, and local tooling state. Shared VS Code settings remain allowed.
/.idea/
/.fleet/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.iml
*.ipr
*.iws
*.code-workspace
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
*.orig
*.rej

# Operating-system metadata.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
